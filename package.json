{
  "name": "repayly",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @repayly/web",
    "build": "npm run build --workspace @repayly/web",
    "lint": "npm run lint --workspace @repayly/web",
    "ios": "npm run ios --workspace @repayly/mobile",
    "start": "npm run start --workspace @repayly/mobile",
    "test": "npm run test --workspaces --if-present"
  }
}
